# ── Supabase Postgres 連線字串 ──
# Supabase Dashboard → Project Settings → Database → Connection string
# 應用程式查詢用「Connection pooling」(port 6543, pgbouncer)，Prisma migrate 用「Direct connection」(port 5432)

# Pooled connection (給 app runtime / @prisma/client 使用)
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (給 prisma migrate / db push 使用)
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"
