// 手術器械管理系統 — Prisma Schema
// 技術棧：Next.js App Router + TypeScript + Supabase (PostgreSQL) + Prisma
//
// 設計重點：
// - 器械編號 (Instrument.code) 為主鍵，命名規則 = 科別首字母 + 類別首字母 + 流水號，建立後不可更改
// - 每次庫存異動都產生「交易序號」(Transaction.serial)，為稽核追蹤的唯一依據
// - 刪除採「封存」(status = ARCHIVED) 而非實刪，保留歷史紀錄可查
// - 共同碼 (commonCode) 讓不同廠牌共用，子代碼 (parentCode) 保留細分追蹤能力
// - AuditLog 為 append-only，記錄所有操作的前後值

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// 列舉
// ─────────────────────────────────────────────

enum Role {
  ADMIN // 管理員：全部功能 + 用戶/交易維護
  OPERATOR // 作業人員：作業類 + 查詢類
  READONLY // 唯讀人員：僅查詢類
}

enum InstrumentStatus {
  ACTIVE // 啟用中
  ARCHIVED // 已封存（取代「改品名為***等三天刪除」的舊流程）
  PENDING_DELETE // 待清除（相容舊流程，可保留）
}

enum TxType {
  REGISTER // 器械建檔
  ADD // 器械增加作業
  REDUCE // 器械減損作業（報廢/遺失/移轉）
  PACK // 盤包配包作業
  UNPACK // 缺料解包作業
  ADJUST // 盤點調整
  ARCHIVE // 封存器械
  EDIT // 交易資料維護（修改已建檔資料）
}

// 減損原因（對應器械減損作業）
enum ReduceReason {
  SCRAP // 報廢
  LOST // 遺失
  TRANSFER // 移轉
}

// ─────────────────────────────────────────────
// 使用者與權限
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  passwordHash String
  role         Role     @default(OPERATOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions Transaction[]
  auditLogs    AuditLog[]

  @@map("users")
}

// ─────────────────────────────────────────────
// 分類維度
// ─────────────────────────────────────────────

model Department {
  code        String       @id // 科別首字母，如 "G"
  name        String // 科別名稱，如 "一般外科"
  createdAt   DateTime     @default(now())
  instruments Instrument[]

  @@map("departments")
}

model Category {
  code        String       @id // 類別首字母，如 "A"
  name        String // 類別名稱，如 "剪刀類"
  createdAt   DateTime     @default(now())
  instruments Instrument[]

  @@map("categories")
}

// ─────────────────────────────────────────────
// 器械主檔
// ─────────────────────────────────────────────

model Instrument {
  code           String           @id // 器械編號（主鍵），如 "GA001"
  name           String // 品名
  brand          String? // 廠牌
  departmentCode String // 科別（編號首字母）
  categoryCode   String // 類別（編號次字母）
  commonCode     String? // 共同碼：不同廠牌共用同一碼
  parentCode     String? // 子代碼：指向主代碼，保留細分追蹤能力
  propertyNo     String? // 財產編號
  unit           String           @default("支")
  quantity       Int              @default(0) // 目前庫存量
  status         InstrumentStatus @default(ACTIVE)
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  archivedAt     DateTime?

  department   Department    @relation(fields: [departmentCode], references: [code])
  category     Category      @relation(fields: [categoryCode], references: [code])
  parent       Instrument?   @relation("SubCode", fields: [parentCode], references: [code])
  children     Instrument[]  @relation("SubCode")
  packItems    PackItem[]
  transactions Transaction[]

  @@index([departmentCode])
  @@index([categoryCode])
  @@index([commonCode])
  @@index([status])
  @@index([propertyNo])
  @@map("instruments")
}

// ─────────────────────────────────────────────
// 盤包
// ─────────────────────────────────────────────

model Pack {
  id          String   @id @default(cuid())
  code        String   @unique // 包別代碼
  name        String // 盤包名稱
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items        PackItem[]
  transactions Transaction[]

  @@map("packs")
}

// 盤包標準清單：某盤包內各器械的標準用量
model PackItem {
  id             String @id @default(cuid())
  packId         String
  instrumentCode String
  standardQty    Int // 標準用量

  pack       Pack       @relation(fields: [packId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentCode], references: [code])

  @@unique([packId, instrumentCode])
  @@map("pack_items")
}

// ─────────────────────────────────────────────
// 交易紀錄（稽核追蹤核心）
// ─────────────────────────────────────────────

model Transaction {
  id             String   @id @default(cuid())
  serial         String   @unique // 交易序號，如 "TX-20260610-0001"
  type           TxType
  instrumentCode String?
  packId         String?
  quantityChange Int      @default(0) // 異動量：+ 增加 / - 減損
  reason         String? // 原因（報廢/遺失/移轉/缺料解包…）
  beforeQty      Int? // 異動前庫存
  afterQty       Int? // 異動後庫存
  note           String?
  operatorId     String
  createdAt      DateTime @default(now())

  instrument Instrument? @relation(fields: [instrumentCode], references: [code])
  pack       Pack?       @relation(fields: [packId], references: [id])
  operator   User        @relation(fields: [operatorId], references: [id])

  @@index([instrumentCode])
  @@index([packId])
  @@index([type])
  @@index([createdAt])
  @@map("transactions")
}

// ─────────────────────────────────────────────
// 稽核日誌（append-only，不可竄改）
// 建議在 Supabase 加上 trigger 阻擋 UPDATE/DELETE，見 README。
// ─────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  action       String // 動作描述，如 "INSTRUMENT_CREATE"
  entity       String // 資料表名，如 "Instrument"
  entityId     String // 受影響的主鍵
  before       Json? // 變更前快照
  after        Json? // 變更後快照
  operatorId   String?
  operatorName String?
  createdAt    DateTime @default(now())

  operator User? @relation(fields: [operatorId], references: [id])

  @@index([entity, entityId])
  @@index([operatorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// 交易序號計數器（每日流水號，原子遞增）
// ─────────────────────────────────────────────

model SerialCounter {
  key   String @id // 如 "TX-20260610"
  value Int    @default(0)

  @@map("serial_counters")
}
